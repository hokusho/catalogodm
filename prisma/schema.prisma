generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id        String   @id @default(uuid())
  url       String
  name      String
  category  String
  brand     String?  @default("")
  priceUSD  Float
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
